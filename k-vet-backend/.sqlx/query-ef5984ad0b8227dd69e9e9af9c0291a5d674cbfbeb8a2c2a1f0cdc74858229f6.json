{
  "db_name": "PostgreSQL",
  "query": "SELECT id, name, content, archived, draft, created_at, updated_at\n           FROM text_block\n           WHERE ($2 OR NOT archived)\n             AND ($1::text IS NULL\n                  OR name ILIKE '%' || $1 || '%'\n                  OR content ILIKE '%' || $1 || '%')\n           ORDER BY name NULLS LAST, id\n           LIMIT $3 OFFSET $4",
