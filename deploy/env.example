# de-DE: Umgebungsdatei für eine k-vet-Instanz. Nach /etc/k-vet/<instanz>.env kopieren —
#        /etc/k-vet/prod.env für `k-vet@prod`, /etc/k-vet/staging.env für `k-vet@staging`.
# en-US: Environment file for one k-vet instance. Copy to /etc/k-vet/<instance>.env —
#        /etc/k-vet/prod.env for `k-vet@prod`, /etc/k-vet/staging.env for `k-vet@staging`.
#
# de-DE: Enthält keine Geheimnisse. Passwörter stehen in /srv/k-vet/<instanz>/config.toml.
# en-US: Holds no secrets. Passwords live in /srv/k-vet/<instance>/config.toml.

# de-DE: Das Abbild, das diese Instanz ausführt — die einzige Zeile, die darüber entscheidet.
#        Die Produktion wechselt die Version, wenn diese Zeile geändert wird, und sonst nie;
#        ein Neustart holt sich niemals „das zuletzt Gebaute“. Wird von `deploy/promote.sh`
#        geschrieben.
# en-US: The image this instance runs — the only line that decides it. Production changes
#        version when this line changes and at no other time; a restart never picks up
#        "whatever was built last". Written by `deploy/promote.sh`.
KVET_VERSION=1.0.0

# de-DE: Host-Port und Interface. Im Container ist es immer 8080; nur der Host-Port
#        unterscheidet sich (Produktion 8080, Test 8081). 0.0.0.0, damit die Praxis vom Laptop
#        und vom Telefon herankommt — beide Bildschirmgrößen sind gleichrangig.
# en-US: Host port and interface. Inside the container it is always 8080; only the host port
#        differs (production 8080, staging 8081). 0.0.0.0 so the practice reaches it from the
#        laptop and the phone — both viewports are first-class.
KVET_HTTP_BIND=0.0.0.0
KVET_HTTP_PORT=8080

# de-DE: Zeitzone. Das Abbild bringt Europe/Berlin mit; hier nur überschreiben, wenn die Praxis
#        woanders sitzt. Nicht kosmetisch: Rechnungsdatum, Zugangsdatum und der nächtliche Lauf
#        fragen die Systemzeit.
# en-US: Time zone. The image ships Europe/Berlin; override here only for a practice elsewhere.
#        Not cosmetic: the invoice date, an intake's arrival date and the nightly job all ask
#        the system clock.
KVET_TZ=Europe/Berlin
